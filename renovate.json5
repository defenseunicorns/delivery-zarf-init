{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>defenseunicorns/uds-common//config/renovate.json5',
    ':semanticCommits',
    ':semanticPrefixFixDepsChoreOthers',
    'replacements:all',
    'workarounds:all',
  ],
  automerge: true,
  platformAutomerge: true,
  ignoreTests: false,
  baseBranchPatterns: [
    'main',
  ],
  schedule: [
    'before 6am on monday',
  ],
  postUpdateOptions: [
    'git-push',
  ],
  rebaseWhen: 'auto',
  labels: [
    'renovate',
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  packageRules: [
    {
      description: 'Format upstream zarf-agent update titles.',
      matchPackageNames: [
        'ghcr.io/zarf-dev/zarf/agent',
      ],
      commitMessageTopic: 'upstream zarf-agent',
      commitMessageExtra: 'to {{newValue}}',
    },
    {
      description: 'Format Registry1 zarf-agent update titles.',
      matchPackageNames: [
        'registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent',
      ],
      commitMessageTopic: 'registry1 zarf-agent',
      commitMessageExtra: 'to {{newValue}}',
    },
    {
      description: 'Format Unicorn zarf-agent update titles.',
      matchPackageNames: [
        'cgr.dev/defenseunicorns.com/zarf-agent-fips',
      ],
      commitMessageTopic: 'unicorn zarf-agent',
      commitMessageExtra: 'to {{newValue}}',
    },
    {
      description: 'gitea images must stay on the minor supported by the gitea chart version pinned in src/init/common/zarf.yaml (chart 12.7.0 -> gitea 1.27.x). Bump the chart pin and this cap together.',
      matchPackageNames: [
        'ghcr.io/go-gitea/gitea',
        'registry1.dso.mil/ironbank/opensource/go-gitea/gitea',
        'cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      allowedVersions: '/^v?1\\.27\\./',
    },
    {
      description: 'Update upstream runtime images together, except for major versions.',
      matchPackageNames: [
        'ghcr.io/zarf-dev/zarf/agent',
        'library/registry',
        'alpine/socat',
        'ghcr.io/go-gitea/gitea',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Upstream image updates',
    },
    {
      description: 'Update Unicorn runtime images together, except for major versions.',
      matchPackageNames: [
        'cgr.dev/defenseunicorns.com/zarf-agent-fips',
        'cgr.dev/defenseunicorns.com/distribution-fips',
        'cgr.dev/defenseunicorns.com/socat-fips',
        'cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Unicorn image updates',
    },
    {
      description: 'Keep Iron Bank updates isolated so slower Registry1 publication does not block upstream or Unicorn flavor updates.',
      matchPackageNames: [
        'registry1.dso.mil/ironbank/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Registry1 image updates',
    },
    {
      description: 'Aggregate GitHub Actions and pre-commit tooling into one CI dependency PR.',
      matchManagers: [
        'github-actions',
        'pre-commit',
      ],
      groupName: 'CI dependencies',
    },
    {
      description: 'Aggregate task-runner and cluster-test dependencies into the CI dependency PR.',
      matchPackageNames: [
        'defenseunicorns/uds-cli',
        'defenseunicorns/uds-common',
        'ghcr.io/defenseunicorns/packages/uds-k3d',
        'ghcr.io/defenseunicorns/packages/uds/bundles/k3d-core-slim-dev',
      ],
      groupName: 'CI dependencies',
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    groupName: 'Security Updates',
    schedule: [],
    dependencyDashboardApproval: false,
    minimumReleaseAge: null,
    rangeStrategy: 'update-lockfile',
    commitMessageSuffix: '[SECURITY]',
    branchTopic: '{{{datasource}}}-{{{depName}}}-vulnerability',
    prCreation: 'immediate',
    labels: [
      'security',
    ],
    automerge: true,
    assignees: [
      '@defenseunicorns/delivery-aws-iac',
    ],
  },
  osvVulnerabilityAlerts: true,
}
