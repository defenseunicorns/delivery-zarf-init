{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>defenseunicorns/uds-common//config/renovate.json5',
    ':semanticCommits',
    ':semanticPrefixFixDepsChoreOthers',
    'replacements:all',
    'workarounds:all',
  ],
  automerge: true,
  platformAutomerge: true,
  ignoreTests: false,
  baseBranchPatterns: [
    'main',
  ],
  schedule: [
    'before 6am on monday',
  ],
  postUpdateOptions: [
    'git-push',
  ],
  rebaseWhen: 'auto',
  labels: [
    'renovate',
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  packageRules: [
    {
      description: 'Update upstream runtime images together, gated on its zarf-agent release.',
      matchPackageNames: [
        'ghcr.io/zarf-dev/zarf/agent',
        'library/registry',
        'alpine/socat',
        'ghcr.io/go-gitea/gitea',
      ],
      groupName: 'Upstream flavor',
      groupSlug: 'upstream-flavor',
      groupSingleUpdates: true,
      semanticCommitScope: 'deps-upstream',
    },
    {
      description: 'Update Registry1 runtime images together, gated on its zarf-agent release.',
      matchPackageNames: [
        'registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent',
        'registry1.dso.mil/ironbank/opensource/docker/registry-v3',
        'registry1.dso.mil/ironbank/opensource/alpine/socat/socat',
        'registry1.dso.mil/ironbank/opensource/go-gitea/gitea',
      ],
      groupName: 'Registry1 flavor',
      groupSlug: 'registry1-flavor',
      groupSingleUpdates: true,
      semanticCommitScope: 'deps-registry1',
    },
    {
      description: 'Update Unicorn runtime images together, gated on its zarf-agent release.',
      matchPackageNames: [
        'cgr.dev/defenseunicorns.com/zarf-agent-fips',
        'cgr.dev/defenseunicorns.com/distribution-fips',
        'cgr.dev/defenseunicorns.com/socat-fips',
        'cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      groupName: 'Unicorn flavor',
      groupSlug: 'unicorn-flavor',
      groupSingleUpdates: true,
      semanticCommitScope: 'deps-unicorn',
    },
    {
      description: 'gitea images must stay on the minor supported by the gitea chart version pinned in src/init/common/zarf.yaml (chart 12.7.0 -> gitea 1.27.x). Bump the chart pin and this cap together.',
      matchPackageNames: [
        'ghcr.io/go-gitea/gitea',
        'registry1.dso.mil/ironbank/opensource/go-gitea/gitea',
        'cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      allowedVersions: '/^v?1\\.27\\./',
    },
    {
      description: 'Treat the shared Gitea chart as a release dependency for every flavor.',
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'gitea',
      ],
      groupName: 'Shared package dependencies',
      groupSlug: 'shared-package-dependencies',
      groupSingleUpdates: true,
      semanticCommitScope: 'deps-shared',
    },
    {
      description: 'Aggregate dependencies that are not shipped in a flavor package.',
      matchPackageNames: [
        '!gitea',
        '!ghcr.io/zarf-dev/zarf/agent',
        '!library/registry',
        '!alpine/socat',
        '!ghcr.io/go-gitea/gitea',
        '!registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent',
        '!registry1.dso.mil/ironbank/opensource/docker/registry-v3',
        '!registry1.dso.mil/ironbank/opensource/alpine/socat/socat',
        '!registry1.dso.mil/ironbank/opensource/go-gitea/gitea',
        '!cgr.dev/defenseunicorns.com/zarf-agent-fips',
        '!cgr.dev/defenseunicorns.com/distribution-fips',
        '!cgr.dev/defenseunicorns.com/socat-fips',
        '!cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      groupName: 'Other dependencies',
      groupSlug: 'other-dependencies',
      groupSingleUpdates: true,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    schedule: [],
    dependencyDashboardApproval: false,
    minimumReleaseAge: null,
    rangeStrategy: 'update-lockfile',
    commitMessageSuffix: '[SECURITY]',
    branchTopic: '{{{datasource}}}-{{{depName}}}-vulnerability',
    prCreation: 'immediate',
    labels: [
      'security',
    ],
    automerge: true,
    assignees: [
      '@defenseunicorns/delivery-aws-iac',
    ],
  },
  osvVulnerabilityAlerts: true,
}
