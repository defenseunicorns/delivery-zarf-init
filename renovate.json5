{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>defenseunicorns/uds-common//config/renovate.json5',
    ':semanticCommits',
    ':semanticPrefixFixDepsChoreOthers',
    'group:all',
    'replacements:all',
    'workarounds:all',
  ],
  automerge: true,
  platformAutomerge: true,
  ignoreTests: false,
  baseBranchPatterns: [
    'main',
  ],
  schedule: [
    'before 6am on monday',
  ],
  postUpdateOptions: [
    'git-push',
  ],
  rebaseWhen: 'auto',
  labels: [
    'renovate',
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)zarf(-.+)?\\.ya?ml$/',
        '/(^|/)zarf-config/.+\\.ya?ml$/',
        '/(^|/)tasks(/.+)?\\.ya?ml$/',
        '/.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*agent_image_tag: (?<currentValue>.*)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*registry_image_tag: (?<currentValue>.*)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*proxy_image_tag: (?<currentValue>.*)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*version: (?<currentValue>.*)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?gitea_image: "?[^"\\s]+:(?<currentValue>[^"@\\s]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"?\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?init:(?<currentValue>[^\\s]+)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*?uds-k3d:(?<currentValue>[^\\s]+)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*ZARF_VERSION: (?<currentValue>.*)\\s',
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+default: (?<currentValue>.*)\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)tasks\\.ya?ml$/',
      ],
      matchStrings: [
        'raw\\.githubusercontent\\.com/(?<depName>defenseunicorns/uds-common)/(?<currentValue>v[\\d.]+)/',
      ],
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      description: 'gitea images (all flavors, kept in lockstep) must stay on the minor supported by the gitea chart version pinned in variants/gitea/zarf.yaml (chart 12.7.0 -> gitea 1.27.x). Bump the chart pin and this cap together.',
      matchPackageNames: [
        'ghcr.io/go-gitea/gitea',
        'registry1.dso.mil/ironbank/opensource/go-gitea/gitea',
        'cgr.dev/defenseunicorns.com/gitea-fips',
      ],
      allowedVersions: '/^v?1\\.27\\./',
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    groupName: 'Security Updates',
    schedule: [],
    dependencyDashboardApproval: false,
    minimumReleaseAge: null,
    rangeStrategy: 'update-lockfile',
    commitMessageSuffix: '[SECURITY]',
    branchTopic: '{{{datasource}}}-{{{depName}}}-vulnerability',
    prCreation: 'immediate',
    labels: [
      'security',
    ],
    automerge: true,
    assignees: [
      '@defenseunicorns/delivery-aws-iac',
    ],
  },
  osvVulnerabilityAlerts: true,
}
