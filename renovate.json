{
  "extends": [
    "github>defenseunicorns/uds-common//config/renovate.json5",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    "replacements:all",
    "workarounds:all"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "baseBranchPatterns": [
    "main"
  ],
  "schedule": [
    "after 7am and before 9am every weekday"
  ],
  "rebaseWhen": "auto",
  "addLabels": [
    "renovate"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/hk.pkl"
      ],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#\"]+",
        "(?m)^[ \\t]*min_hk_version[ \\t]*=[ \\t]*\"(?<currentValue>[^\"\\r\\n]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update release metadata and immutable commits for raw GitHub task dependencies.",
      "managerFilePatterns": [
        "/^tasks\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)\\n[^\\n]*https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentDigest>[a-f0-9]{40})/"
      ]
    },
    {
      "customType": "regex",
      "description": "Update flavor image tags and digests; existing platform digests preserve the target architecture.",
      "managerFilePatterns": [
        "/^flavors/[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate-digest: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\s+(?:[^\\n]+_image_tag: |gitea_image: [^\\s]+:)(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the shared Zarf source pin in the list-style task variables.",
      "managerFilePatterns": [
        "/(^|/)tasks\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*- name: ZARF_SOURCE_VERSION\\s*\\n\\s*default: (?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group CI, test, and repository automation dependencies.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "CI dependencies",
      "groupSlug": "ci-dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "semanticCommitScope": "deps-ci"
    },
    {
      "description": "Group dependencies shipped in the Zarf packages.",
      "matchFileNames": [
        "components/**",
        "flavors/**",
        "packages/**",
        "releaser.yaml"
      ],
      "groupName": "Package dependencies",
      "groupSlug": "package-dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "semanticCommitScope": "deps-pkg"
    },
    {
      "description": "Keep the shared Zarf source pin with package dependencies.",
      "matchPackageNames": [
        "ghcr.io/zarf-dev/zarf/agent",
        "registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent",
        "cgr.dev/defenseunicorns.com/zarf-agent-fips"
      ],
      "groupName": "Package dependencies",
      "groupSlug": "package-dependencies",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "semanticCommitScope": "deps-pkg"
    },
    {
      "description": "Restrict registry images to release tags used across flavors.",
      "matchPackageNames": [
        "library/registry",
        "registry1.dso.mil/ironbank/opensource/docker/registry-v3",
        "cgr.dev/defenseunicorns.com/distribution-fips"
      ],
      "allowedVersions": "/^v?\\d+(\\.\\d+)+(-arm64)?$/"
    },
    {
      "description": "Restrict Socat images to release tags used across flavors.",
      "matchPackageNames": [
        "alpine/socat",
        "registry1.dso.mil/ironbank/opensource/alpine/socat/socat",
        "cgr.dev/defenseunicorns.com/socat-fips"
      ],
      "allowedVersions": "/^v?\\d+(\\.\\d+)+(-arm64)?$/"
    },
    {
      "description": "Restrict the shared Zarf release to matching architecture tags.",
      "matchPackageNames": [
        "ghcr.io/zarf-dev/zarf/agent",
        "registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent",
        "cgr.dev/defenseunicorns.com/zarf-agent-fips"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+(-arm64)?$/"
    },
    {
      "description": "Keep Gitea images on the minor supported by the chart pinned in components/common/zarf.yaml.",
      "matchPackageNames": [
        "ghcr.io/go-gitea/gitea",
        "registry1.dso.mil/ironbank/opensource/go-gitea/gitea",
        "cgr.dev/defenseunicorns.com/gitea-fips"
      ],
      "allowedVersions": "/^v?1\\.27\\.\\d+(-(rootless|amd64|arm64))?$/"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "rangeStrategy": "update-lockfile",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
    "prCreation": "immediate",
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true
}
