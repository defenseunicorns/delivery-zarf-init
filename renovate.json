{
  "extends": [
    "github>defenseunicorns/uds-ops-common//config/renovate.json5"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "ignoreTests": false,
  "baseBranchPatterns": [
    "main"
  ],
  "schedule": [
    "after 7am and before 9am every weekday"
  ],
  "postUpdateOptions": [
    "git-push"
  ],
  "rebaseWhen": "auto",
  "addLabels": [
    "renovate"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the shared Zarf source pin in the list-style task variables.",
      "managerFilePatterns": [
        "/(^|/)tasks\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s*\\n\\s*- name: ZARF_SOURCE_VERSION\\s*\\n\\s*default: (?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the shared Zarf source pin with package dependencies.",
      "matchPackageNames": [
        "ghcr.io/zarf-dev/zarf/agent",
        "registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent",
        "cgr.dev/defenseunicorns.com/zarf-agent-fips"
      ],
      "groupName": "Package dependencies",
      "groupSlug": "package-dependencies",
      "groupSingleUpdates": true,
      "semanticCommitScope": "deps-pkg"
    },
    {
      "description": "Restrict registry images to release tags used across flavors.",
      "matchPackageNames": [
        "library/registry",
        "registry1.dso.mil/ironbank/opensource/docker/registry-v3",
        "cgr.dev/defenseunicorns.com/distribution-fips"
      ],
      "allowedVersions": "/^v?\\d+(\\.\\d+)+(-arm64)?$/"
    },
    {
      "description": "Restrict Socat images to release tags used across flavors.",
      "matchPackageNames": [
        "alpine/socat",
        "registry1.dso.mil/ironbank/opensource/alpine/socat/socat",
        "cgr.dev/defenseunicorns.com/socat-fips"
      ],
      "allowedVersions": "/^v?\\d+(\\.\\d+)+(-arm64)?$/"
    },
    {
      "description": "Restrict the shared Zarf release to matching architecture tags.",
      "matchPackageNames": [
        "ghcr.io/zarf-dev/zarf/agent",
        "registry1.dso.mil/ironbank/opensource/zarf-dev/zarf/zarf-agent",
        "cgr.dev/defenseunicorns.com/zarf-agent-fips"
      ],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+(-arm64)?$/"
    },
    {
      "description": "Keep Gitea images on the minor supported by the chart pinned in components/common/zarf.yaml.",
      "matchPackageNames": [
        "ghcr.io/go-gitea/gitea",
        "registry1.dso.mil/ironbank/opensource/go-gitea/gitea",
        "cgr.dev/defenseunicorns.com/gitea-fips"
      ],
      "allowedVersions": "/^v?1\\.27\\.\\d+(-(rootless|amd64|arm64))?$/"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "rangeStrategy": "update-lockfile",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depName}}}-vulnerability",
    "prCreation": "immediate",
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "osvVulnerabilityAlerts": true
}
